{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tavern Client",
  "version": "0.1.0",
  "identifier": "local.tavern.client",
  "build": {
    "frontendDist": "../../client/public"
  },
  "app": {
    "withGlobalTauri": true,
    "security": {
      "capabilities": [
        {
          "identifier": "remote-tavern-main",
          "description": "Allow remote Tavern servers loaded in the main window to use Tauri IPC for desktop notifications and wrapper commands.",
          "windows": ["main"],
          "remote": {
            "urls": ["http://*", "https://*"]
          },
          "permissions": [
            "core:default",
            "notification:default",
            "opener:default",
            "updater:default",
            "allow-desktop-notify",
            "allow-desktop-open-external-url",
            "allow-desktop-check-for-updates"
          ]
        }
      ]
    },
    "windows": [
      {
        "label": "main",
        "title": "Tavern Client",
        "dragDropEnabled": false,
        "width": 1280,
        "height": 840,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "center": true,
        "url": "desktop-connect.html"
      }
    ]
  },
  "plugins": {
    "updater": {
      "active": false,
      "endpoints": [],
      "pubkey": ""
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "../../client/public/favicon.svg",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {}
    }
  }
}
